# Copy to .env to override defaults. Everything works without a .env file.

# Host ports (all bound to 127.0.0.1)
SHOP_PORT=8080          # shop, /api, /api-docs
LAB_PORT=8081           # teaching dashboard
PG_PORT=55432           # PostgreSQL (user lab_readonly / lab_readonly_pw)
MONGO_PORT=57017        # MongoDB    (user lab_readonly / lab_readonly_pw, authSource=admin)
REDIS_PORT=56379
RABBITMQ_UI_PORT=15672  # RabbitMQ console (qamart / qamart_pw)
ADMINER_PORT=8082       # Adminer SQL browser

# Secrets for LOCAL use only. Change them if you expose the lab beyond your laptop.
JWT_SECRET=local-dev-jwt-secret-change-me
INTERNAL_TOKEN=local-internal-token
LAB_TOKEN=local-lab-token

# Teaching mode. Set to false (or use docker-compose.prod.yml) to disable all lab features.
LAB_MODE=true
